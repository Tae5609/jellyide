# Copy to .env (same directory as docker-compose.prod.yml) and adjust.

# Image to run (local build or registry pull)
IMAGE=jellyide:latest
# IMAGE=ghcr.io/tae5609/jellyide:latest

# Host port the web UI / API listens on
PORT=8080

# Music library path on the host (mounted read/write into the container)
MUSIC_DIR=/mnt/media/music

# Number of parallel yt-dlp downloads
CONCURRENT_DOWNLOAD=2
