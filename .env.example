# Copy to .env (same directory as docker-compose.prod.yml) and adjust.
# Every variable is also listed in docs/DEPLOYMENT.md with its code default.

# Image to run (local build or registry pull)
IMAGE=jellyide:latest
# IMAGE=ghcr.io/tae5609/jellyide:latest

# Host port the web UI / API listens on
PORT=8080

# Music library path on the host (mounted read/write into the container)
MUSIC_DIR=/mnt/media/music

# Number of parallel yt-dlp downloads.
# Note: not read by the server today (the limit is hardcoded to 2 at
# startup and can be changed at runtime on the Settings page). See
# docs/plan/BUGS.md.
CONCURRENT_DOWNLOAD=2

# --- Storage -------------------------------------------------------------
# Container path of the music dir (the volume mount above). The SQLite
# database and the SAML cert/key live inside this directory.
DOWNLOAD_DIR=/mnt/media/music

# --- Authentication -------------------------------------------------------
# Master switch for authentication. false = no login at all; every
# visitor is treated as an anonymous superuser.
AUTH_ENABLED=true
# Allow username/password login (local accounts).
AUTH_LOCAL_ENABLED=true
# Set the Secure flag on the session cookie. Use true when the site is
# served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# Bootstrapped admin account. Created only on the very first start, when
# the database has no users yet; afterwards the values in the database
# win (change them in the app). ADMIN_PASSWORD must be set at that first
# start or the server refuses to start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public base URL of this instance, exactly as the browser sees it
# (scheme + host + port, no trailing path). Used for the OIDC redirect
# URI and the SAML metadata/ACS URLs.
PUBLIC_URL=http://localhost:8080

# Initial registration mode: admin_only (default), open or approval.
# Seeded into the database once at first start; afterwards the value in
# the admin UI (Users page) wins over this variable.
REGISTRATION_MODE=admin_only

# --- OIDC / SSO (optional) ------------------------------------------------
OIDC_ENABLED=false
# Button name shown on the login page.
OIDC_NAME=SSO
# Provider discovery URL, e.g. https://id.example.com/realms/jellyide.
# Required together with OIDC_CLIENT_ID and OIDC_CLIENT_SECRET when
# OIDC_ENABLED=true.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated scopes. Default: openid,profile,email
#OIDC_SCOPES=openid,profile,email
# Users whose group list contains this group become admins.
#OIDC_ADMIN_GROUP=
# Claim in the id_token that carries the group list. Default: groups
#OIDC_GROUPS_CLAIM=groups
# Create a local account on first login. Default: true
#OIDC_AUTO_CREATE=true

# --- SAML (optional) --------------------------------------------------------
SAML_ENABLED=false
# Button name shown on the login page.
SAML_NAME=SAML
# IdP metadata: set exactly one of URL or file.
SAML_IDP_METADATA_URL=
SAML_IDP_METADATA_FILE=
# SP certificate and private key. Defaults: <DOWNLOAD_DIR>/saml/sp.crt
# and <DOWNLOAD_DIR>/saml/sp.key — a self-signed pair is generated on
# first start when missing. Keep that directory persistent (it lives in
# the music volume by default); if the key is lost, the IdP's trust of
# this SP is broken.
#SAML_SP_CERT=
#SAML_SP_KEY=
# Attribute names in the SAML assertion (matched by Name or FriendlyName).
# An empty username attribute falls back to the assertion's NameID.
#SAML_USERNAME_ATTR=
SAML_EMAIL_ATTR=email
SAML_NAME_ATTR=displayName
SAML_GROUPS_ATTR=groups
# Users whose group list contains this group become admins.
#SAML_ADMIN_GROUP=
# Create a local account on first login. Default: true
#SAML_AUTO_CREATE=true
